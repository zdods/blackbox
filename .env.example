# JWT_SECRET signs session tokens. If unset, the server generates a random
# ephemeral secret at startup (secure, but all sessions reset on restart).
# Must be at least 32 bytes. Set a long random value in production, e.g.:
# openssl rand -base64 32
# JWT_SECRET=your-secret-key

# TOTP_ENC_KEY encrypts TOTP (2FA) secrets at rest (base64 of 32 bytes, e.g.
# openssl rand -base64 32). If unset, a key is derived from a stable JWT_SECRET;
# with neither, TOTP secrets are stored in plaintext (set one in production).
# TOTP_ENC_KEY=your-base64-32-byte-key

# COOKIE_SECURE=1 forces the Secure flag on the session cookie. Set this when
# TLS terminates at a reverse proxy (so the bastion speaks plain HTTP but the
# browser still talks HTTPS).
# COOKIE_SECURE=1

# AUTH_MODE selects which sign-in methods are offered: "password" (username +
# password + TOTP; the default), "passkey" (WebAuthn / passkeys, usernameless
# login), or "both" (offer each side by side on the login + register screens).
# Passkey enrollment/management is available in every mode, so you can add a
# passkey while in password mode and then switch. "passkey" requires RP_ID
# below; "both" uses passkeys when RP_ID is set and otherwise falls back to
# password-only.
# AUTH_MODE=both

# RP_ID is the WebAuthn Relying Party ID — your registrable domain ONLY, with no
# scheme or port (e.g. blackhaul.example.com). Required for passkeys; must match
# the public hostname the browser uses. Use "localhost" for local HTTP dev.
# RP_ID=blackhaul.example.com

# RP_ORIGINS are the full allowed origins (scheme + host + non-default port),
# comma-separated. Defaults to https://<RP_ID> when unset. For local dev use
# http://localhost:8080.
# RP_ORIGINS=https://blackhaul.example.com

# RP_DISPLAY_NAME is the relying-party name authenticators show during a passkey
# prompt. Defaults to "Blackhaul".
# RP_DISPLAY_NAME=Blackhaul

# DEV_MODE=1 uses a stable (insecure) development JWT secret so sessions
# survive container rebuilds. Never set in production. `make dev` sets this.
# DEV_MODE=1

# TRUST_PROXY=1 makes the server read client IPs from X-Forwarded-For (for
# rate limiting). Only set when running behind a reverse proxy that
# overwrites that header.
# TRUST_PROXY=1

# Docker Compose (optional; defaults match current behavior).
# Postgres is bound to 127.0.0.1 only, but CHANGE POSTGRES_PASSWORD before any
# deployment where the host is shared or reachable beyond loopback — the default
# postgres/postgres is for local dev only.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=blackhaul
# POSTGRES_PORT=5432   # bound to 127.0.0.1 on the host
# BASTION_PORT=8080

# For local blackhaul-server (without Docker), if not set defaults are used:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/blackhaul?sslmode=disable
# SERVER_ADDR=:8080
# STATIC_DIR=web/build

# TLS (optional): enable HTTPS and WSS. Use wss:// and https:// for daemons and browser.
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
